# ==============================================================================
# REZO AYITI - Configuration des Variables d'Environnement
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Variables CLIENT (Publiques - Exposées au navigateur)
# ------------------------------------------------------------------------------
# URL de l'instance Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé anonyme publique Supabase (Project Settings > API > anon public key)
# Utilisée pour les requêtes publiques du navigateur et soumise aux politiques RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Variables SERVEUR (Secrètes - STRICTEMENT CONFIDENTIELLES)
# NE JAMAIS PRÉFIXER PAR NEXT_PUBLIC_ ET NE JAMAIS COMMITER DANS GIT !
# ------------------------------------------------------------------------------
# Clé de service Supabase (Project Settings > API > service_role secret key)
# Utilisée exclusivement par l'API backend pour valider les signalements et gérer le rate-limiting.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Sel cryptographique pour le hachage d'anonymisation des adresses IP (SHA-256)
# Générer une chaîne aléatoire d'au moins 32 caractères hexadécimaux
RATE_LIMIT_SALT=un_sel_cryptographique_aleatoire_secret_et_long_32chars
